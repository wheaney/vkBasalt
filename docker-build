#!/usr/bin/env bash
set -e

# Usage: ./docker-build [x86_64|aarch64]   (or set ARCH; default: both)
# aarch64 builds on an x86 host require qemu binfmt support, e.g.:
#   docker run --privileged --rm tonistiigi/binfmt --install all

mkdir -p out

ARCH=${1:-$ARCH}

if [[ "$ARCH" == "x86_64" || -z "$ARCH" ]]; then
    docker build --platform linux/amd64 -f $PWD/docker/Dockerfile -t vkbasalt .
    docker run --rm -i --platform linux/amd64 -v $PWD/docker:/docker -v $PWD/out:/out vkbasalt
fi

if [[ "$ARCH" == "aarch64" || -z "$ARCH" ]]; then
    docker buildx build --platform linux/arm64 -f $PWD/docker/Dockerfile.aarch64 -t vkbasalt:arm64 --load .
    docker run --rm -i --platform linux/arm64 -v $PWD/docker:/docker -v $PWD/out:/out vkbasalt:arm64
fi
